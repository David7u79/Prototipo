---
import '../styles/global.css';
import { navigation } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Astro sirve las páginas como directorios: /avance y /avance/ son la misma ruta.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d18" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="sticky top-0 z-20 border-b border-line bg-bg/80 backdrop-blur">
      <div
        class="shell flex min-h-16 flex-wrap items-center justify-between gap-x-5 gap-y-2 py-3"
      >
        <a class="flex items-center gap-2 text-lg font-black no-underline" href="/">
          <img src="/logo.svg" alt="" width="32" height="32" />
          GarFit
        </a>
        <nav aria-label="Navegación principal">
          <ul class="m-0 flex list-none flex-wrap justify-end gap-x-4 gap-y-2 p-0 text-sm font-semibold sm:gap-x-6">
            {
              navigation.map(({ href, label }) => (
                <li>
                  <a
                    class:list={[
                      'no-underline transition hover:text-ink',
                      currentPath === href ? 'text-accent' : 'text-muted',
                    ]}
                    href={href}
                    aria-current={currentPath === href ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="border-t border-line py-10">
      <div class="shell flex flex-col gap-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p class="m-0 flex items-center gap-2 font-bold text-ink">
          <img src="/logo.svg" alt="" width="24" height="24" />
          GarFit <span class="font-normal text-muted">· Entrena · Registra · Evoluciona</span>
        </p>
        <p class="m-0">
          Gratis y sin anuncios · <a class="font-semibold text-accent no-underline" href="/avance">Avance del proyecto</a>
        </p>
      </div>
    </footer>
  </body>
</html>
