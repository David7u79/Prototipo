# Entornos admitidos: development (local), test (suite), demo (composición de demostración)
# y production. Sólo test omite el límite de peticiones; fake IA se permite fuera de production.
NODE_ENV=development
PORT=4000
# PostgreSQL local definido en docker-compose.yml.
DATABASE_URL=postgresql://garfit:garfit@localhost:5442/garfit
TEST_DATABASE_URL=postgresql://garfit:garfit@localhost:5442/garfit_test
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:8081
SWAGGER_ENABLED=true
# Usa un secreto de al menos 32 caracteres; el ejemplo no incluye secretos.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# ID público OAuth web; vacío desactiva Google.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_EXTRA_AUDIENCES=
# Vacío usa storage/releases desde la raíz del repositorio.
RELEASES_STORAGE_DIR=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=true
AI_PROVIDER=gemini
AI_TIMEOUT_MS=25000
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=100
# Datos de la cuenta demo. No uses una contraseña real.
DEMO_USER_EMAIL=demo@garfit.example
DEMO_USER_PASSWORD=
