// Modelo de datos de GarFit — Fase 1 (fundación).
// Fuente de verdad del ERD: `pnpm docs:generate` produce docs/generated/database/erd.svg.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/generated/database/erd.svg"
  renderer = "graphviz"
}

datasource db {
  provider = "postgresql"
}

/// Proveedor de identidad con el que el usuario demuestra quién es.
enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PrimaryGoal {
  STRENGTH
  ENDURANCE
  HYPERTROPHY
  WEIGHT_LOSS
  GENERAL_FITNESS
}

enum ReleasePlatform {
  ANDROID
}

// Los enums siguientes deben coincidir con @garfit/domain y @garfit/movements (fuente de
// verdad); apps/api/test/shared-enums.spec.ts falla si divergen.

/// Sistema de unidades preferido para mostrar pesos y distancias.
enum UnitSystem {
  METRIC
  IMPERIAL
}

/// Qué mide una marca personal. TIME: menor es mejor; el resto: mayor es mejor.
enum RecordType {
  WEIGHT
  REPS
  DISTANCE
  DURATION
  TIME
}

/// Unidad con la que se introdujo una marca.
enum RecordUnit {
  KILOGRAM
  POUND
  REPETITION
  METER
  KILOMETER
  MILE
  SECOND
}

/// MANUAL: la registró el atleta. WORKOUT: derivada de un resultado de entrenamiento (fase 3).
enum RecordSource {
  MANUAL
  WORKOUT
}

/// Región corporal asignada por la fuente del catálogo.
enum MovementCategory {
  WAIST
  UPPER_LEGS
  LOWER_LEGS
  BACK
  CHEST
  SHOULDERS
  UPPER_ARMS
  LOWER_ARMS
  NECK
  CARDIO
}

enum Equipment {
  BODY_WEIGHT
  ASSISTED
  WEIGHTED
  BARBELL
  OLYMPIC_BARBELL
  EZ_BARBELL
  TRAP_BAR
  SMITH_MACHINE
  DUMBBELL
  KETTLEBELL
  CABLE
  LEVERAGE_MACHINE
  SLED_MACHINE
  BAND
  RESISTANCE_BAND
  MEDICINE_BALL
  STABILITY_BALL
  BOSU_BALL
  ROPE
  ROLLER
  WHEEL_ROLLER
  HAMMER
  TIRE
  STATIONARY_BIKE
  ELLIPTICAL_MACHINE
  STEPMILL_MACHINE
  SKIERG_MACHINE
  UPPER_BODY_ERGOMETER
  ROWING_MACHINE
}

enum MuscleGroup {
  ABS
  OBLIQUES
  CORE
  HIP_FLEXORS
  LOWER_BACK
  UPPER_BACK
  LATS
  TRAPS
  NECK
  CHEST
  SHOULDERS
  SERRATUS_ANTERIOR
  BICEPS
  TRICEPS
  FOREARMS
  GLUTES
  QUADRICEPS
  HAMSTRINGS
  ADDUCTORS
  ABDUCTORS
  CALVES
  ANKLES_AND_FEET
  CARDIOVASCULAR_SYSTEM
}

enum MovementDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Modalidad del entrenamiento: decide el score global (ver @garfit/domain WORKOUT_TYPES).
enum WorkoutType {
  STRENGTH
  FOR_TIME
  AMRAP
  EMOM
  CARDIO
  CUSTOM
}

/// DRAFT editable · IN_PROGRESS estructura fija · COMPLETED inmutable y con marcas derivadas.
enum WorkoutStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

/// Persona que usa GarFit. Un único User por correo, sin importar cuántos proveedores vincule.
model User {
  id              String    @id @default(uuid(7))
  /// Siempre en minúsculas.
  email           String    @unique
  name            String?
  avatarUrl       String?
  /// Fecha en que un proveedor confiable (Google) verificó el correo. Null = no verificado.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        AuthAccount[]
  sessions        Session[]
  profile         AthleteProfile?
  personalRecords PersonalRecord[]
  workouts        Workout[]
  /// WODs personales (privados) creados por el atleta.
  wods            Wod[]
}

/// Vínculo entre un User y un proveedor de identidad.
/// LOCAL: providerAccountId = correo normalizado y passwordHash (argon2id) presente.
/// GOOGLE: providerAccountId = claim `sub` del ID token; passwordHash nulo.
model AuthAccount {
  id                String       @id @default(uuid(7))
  userId            String
  provider          AuthProvider
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

/// Sesión emitida por GarFit. Sólo se guarda el hash SHA-256 del refresh token (rotativo).
model Session {
  id               String    @id @default(uuid(7))
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Perfil deportivo del atleta (1:1 con User).
model AthleteProfile {
  id              String          @id @default(uuid(7))
  userId          String          @unique
  displayName     String
  experienceLevel ExperienceLevel
  primaryGoal     PrimaryGoal
  preferredUnits  UnitSystem      @default(METRIC)
  /// Datos opcionales útiles para contextualizar el progreso. Sin información médica.
  birthDate       DateTime?       @db.Date
  heightCm        Decimal?        @db.Decimal(4, 1)
  /// Siempre en kg; los clientes convierten según preferredUnits.
  weightKg        Decimal?        @db.Decimal(5, 2)
  trainingSince   DateTime?       @db.Date
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Movimiento del catálogo controlado por el proyecto (semilla desde @garfit/movements).
model Movement {
  id               String              @id @default(uuid(7))
  /// Identificador estable y público; la semilla hace upsert por slug.
  slug             String              @unique
  name             String
  /// Resumen propio. La fuente actual no lo aporta: puede ser nulo.
  description      String?
  instructions     String[]
  category         MovementCategory
  equipment        Equipment
  /// Nulo cuando la fuente no clasifica la dificultad (no se inventa).
  difficulty       MovementDifficulty?
  primaryMuscles   MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  /// Tipos de marca que admite (reglas en @garfit/movements/record-types).
  recordTypes      RecordType[]
  /// Origen del dato para trazabilidad, p. ej. "hasaneyldrm/exercises-dataset" + "0043".
  source           String?
  sourceId         String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  personalRecords  PersonalRecord[]
  workoutExercises WorkoutExercise[]
  wodExercises     WodExercise[]

  @@unique([source, sourceId])
  @@index([isActive, name])
  @@index([category])
  @@index([equipment])
}

/// Registro de una marca personal. Cada registro se conserva para calcular la evolución:
/// no se sobrescribe; se corrige con PATCH y se retira con borrado lógico (deletedAt).
model PersonalRecord {
  id              String       @id @default(uuid(7))
  userId          String
  movementId      String
  recordType      RecordType
  /// Valor tal como lo introdujo el atleta, en `unit`.
  value           Decimal      @db.Decimal(12, 3)
  unit            RecordUnit
  /// Valor en unidad canónica (kg, repeticiones, metros o segundos). Se compara con éste.
  normalizedValue Decimal      @db.Decimal(14, 3)
  /// Sólo en marcas de carga: repeticiones de la marca (1 = 1RM).
  repetitions     Int?
  /// Calificador de distancia (obligatorio en TIME): distancia sobre la que se midió el tiempo.
  distanceValue   Decimal?     @db.Decimal(12, 3)
  distanceUnit    RecordUnit?
  /// Distancia calificadora en metros; forma parte de la serie comparable.
  distanceMeters  Decimal?     @db.Decimal(14, 3)
  performedAt     DateTime     @db.Date
  notes           String?
  source          RecordSource @default(MANUAL)
  /// Resultado de entrenamiento que originó la marca (source = WORKOUT).
  workoutResultId String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movement      Movement       @relation(fields: [movementId], references: [id], onDelete: Restrict)
  workoutResult WorkoutResult? @relation(fields: [workoutResultId], references: [id], onDelete: NoAction)

  // Idempotencia: un mismo resultado no puede generar dos marcas del mismo tipo.
  @@unique([workoutResultId, recordType])
  @@index([userId, deletedAt, performedAt])
  @@index([userId, movementId, recordType])
}

/// Plantilla reutilizable de entrenamiento (p. ej. "Fran"). Pública si ownerId es nulo
/// (catálogo del proyecto); privada del atleta si tiene ownerId.
model Wod {
  id              String      @id @default(uuid(7))
  slug            String      @unique
  name            String
  description     String?
  workoutType     WorkoutType
  /// AMRAP/EMOM: duración total; FOR_TIME: tiempo límite opcional.
  durationSeconds Int?
  /// Rondas prescritas (FOR_TIME por rondas, CUSTOM).
  rounds          Int?
  /// EMOM: duración de cada intervalo.
  intervalSeconds Int?
  /// Esquema de repeticiones por ronda, p. ej. [21, 15, 9].
  repScheme       Int[]
  isBenchmark     Boolean     @default(false)
  source          String?
  ownerId         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exercises WodExercise[]
  workouts  Workout[]

  @@index([ownerId])
  @@index([isBenchmark])
}

/// Movimiento prescrito en un WOD, en orden.
model WodExercise {
  id              String      @id @default(uuid(7))
  wodId           String
  movementId      String
  position        Int
  /// Repeticiones por ronda (null si las marca repScheme del WOD).
  reps            Int?
  loadValue       Decimal?    @db.Decimal(12, 3)
  loadUnit        RecordUnit?
  distanceValue   Decimal?    @db.Decimal(12, 3)
  distanceUnit    RecordUnit?
  durationSeconds Int?
  notes           String?

  wod      Wod      @relation(fields: [wodId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([wodId, position])
}

/// Sesión personal de entrenamiento de un atleta. Puede nacer de un WOD (copia de su
/// prescripción) o crearse libre. Nunca representa una clase ni una sesión de gimnasio.
model Workout {
  id              String        @id @default(uuid(7))
  userId          String
  wodId           String?
  name            String
  description     String?
  notes           String?
  workoutType     WorkoutType
  status          WorkoutStatus @default(DRAFT)
  durationSeconds Int?
  rounds          Int?
  intervalSeconds Int?
  repScheme       Int[]
  /// Fecha en que se realizó; se fija al completar (hoy por defecto).
  performedOn     DateTime?     @db.Date
  startedAt       DateTime?
  completedAt     DateTime?
  /// Borrado lógico: conserva la trazabilidad de las marcas derivadas.
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wod       Wod?              @relation(fields: [wodId], references: [id], onDelete: Restrict)
  exercises WorkoutExercise[]
  score     WorkoutScore?

  @@index([userId, deletedAt, status, performedOn])
  @@index([wodId])
}

/// Movimiento dentro de un entrenamiento, con su prescripción opcional, en orden.
model WorkoutExercise {
  id                    String      @id @default(uuid(7))
  workoutId             String
  movementId            String
  position              Int
  targetSets            Int?
  targetReps            Int?
  targetLoadValue       Decimal?    @db.Decimal(12, 3)
  targetLoadUnit        RecordUnit?
  targetDistanceValue   Decimal?    @db.Decimal(12, 3)
  targetDistanceUnit    RecordUnit?
  targetDurationSeconds Int?
  restSeconds           Int?
  notes                 String?

  workout  Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  movement Movement        @relation(fields: [movementId], references: [id], onDelete: Restrict)
  results  WorkoutResult[]

  @@unique([workoutId, position])
  @@index([movementId])
}

/// Serie realizada de un ejercicio. Datos estructurados: nunca "5x90, 5x95" como texto.
model WorkoutResult {
  id                String      @id @default(uuid(7))
  workoutExerciseId String
  setNumber         Int
  reps              Int?
  loadValue         Decimal?    @db.Decimal(12, 3)
  loadUnit          RecordUnit?
  loadKg            Decimal?    @db.Decimal(12, 3)
  distanceValue     Decimal?    @db.Decimal(12, 3)
  distanceUnit      RecordUnit?
  distanceMeters    Decimal?    @db.Decimal(14, 3)
  durationSeconds   Int?
  createdAt         DateTime    @default(now())

  workoutExercise WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  personalRecords PersonalRecord[]

  @@unique([workoutExerciseId, setNumber])
}

/// Resultado global del entrenamiento (1:1). Qué campos aplican depende de workoutType.
model WorkoutScore {
  workoutId     String   @id
  timeSeconds   Int?
  repsAtTimeCap Int?
  rounds        Int?
  extraReps     Int?
  completed     Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

/// Versión distribuible de la app móvil. El binario vive en ReleaseStorage bajo `filePath`.
model AppRelease {
  id          String          @id @default(uuid(7))
  platform    ReleasePlatform
  /// SemVer, p. ej. 1.0.0.
  version     String
  versionCode Int
  fileName    String
  /// Clave relativa dentro del almacenamiento (nunca una ruta absoluta).
  filePath    String
  fileSize    Int
  sha256      String
  changelog   String[]
  published   Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())

  @@unique([platform, version])
  @@unique([platform, versionCode])
  @@index([platform, published, versionCode])
}
