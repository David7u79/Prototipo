// Modelo de datos de GarFit — Fase 1 (fundación).
// Fuente de verdad del ERD: `pnpm docs:generate` produce docs/generated/database/erd.svg.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/generated/database/erd.svg"
  renderer = "graphviz"
}

datasource db {
  provider = "postgresql"
}

/// Proveedor de identidad con el que el usuario demuestra quién es.
enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PrimaryGoal {
  STRENGTH
  ENDURANCE
  HYPERTROPHY
  WEIGHT_LOSS
  GENERAL_FITNESS
}

enum ReleasePlatform {
  ANDROID
}

// Los enums siguientes deben coincidir con @garfit/domain y @garfit/movements (fuente de
// verdad); apps/api/test/shared-enums.spec.ts falla si divergen.

/// Sistema de unidades preferido para mostrar pesos y distancias.
enum UnitSystem {
  METRIC
  IMPERIAL
}

/// Qué mide una marca personal. TIME: menor es mejor; el resto: mayor es mejor.
enum RecordType {
  WEIGHT
  REPS
  DISTANCE
  DURATION
  TIME
}

/// Unidad con la que se introdujo una marca.
enum RecordUnit {
  KILOGRAM
  POUND
  REPETITION
  METER
  KILOMETER
  MILE
  SECOND
}

/// MANUAL: la registró el atleta. WORKOUT: derivada de un resultado de entrenamiento (fase 3).
enum RecordSource {
  MANUAL
  WORKOUT
}

/// Región corporal asignada por la fuente del catálogo.
enum MovementCategory {
  WAIST
  UPPER_LEGS
  LOWER_LEGS
  BACK
  CHEST
  SHOULDERS
  UPPER_ARMS
  LOWER_ARMS
  NECK
  CARDIO
}

enum Equipment {
  BODY_WEIGHT
  ASSISTED
  WEIGHTED
  BARBELL
  OLYMPIC_BARBELL
  EZ_BARBELL
  TRAP_BAR
  SMITH_MACHINE
  DUMBBELL
  KETTLEBELL
  CABLE
  LEVERAGE_MACHINE
  SLED_MACHINE
  BAND
  RESISTANCE_BAND
  MEDICINE_BALL
  STABILITY_BALL
  BOSU_BALL
  ROPE
  ROLLER
  WHEEL_ROLLER
  HAMMER
  TIRE
  STATIONARY_BIKE
  ELLIPTICAL_MACHINE
  STEPMILL_MACHINE
  SKIERG_MACHINE
  UPPER_BODY_ERGOMETER
}

enum MuscleGroup {
  ABS
  OBLIQUES
  CORE
  HIP_FLEXORS
  LOWER_BACK
  UPPER_BACK
  LATS
  TRAPS
  NECK
  CHEST
  SHOULDERS
  SERRATUS_ANTERIOR
  BICEPS
  TRICEPS
  FOREARMS
  GLUTES
  QUADRICEPS
  HAMSTRINGS
  ADDUCTORS
  ABDUCTORS
  CALVES
  ANKLES_AND_FEET
  CARDIOVASCULAR_SYSTEM
}

enum MovementDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Persona que usa GarFit. Un único User por correo, sin importar cuántos proveedores vincule.
model User {
  id              String    @id @default(uuid(7))
  /// Siempre en minúsculas.
  email           String    @unique
  name            String?
  avatarUrl       String?
  /// Fecha en que un proveedor confiable (Google) verificó el correo. Null = no verificado.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        AuthAccount[]
  sessions        Session[]
  profile         AthleteProfile?
  personalRecords PersonalRecord[]
}

/// Vínculo entre un User y un proveedor de identidad.
/// LOCAL: providerAccountId = correo normalizado y passwordHash (argon2id) presente.
/// GOOGLE: providerAccountId = claim `sub` del ID token; passwordHash nulo.
model AuthAccount {
  id                String       @id @default(uuid(7))
  userId            String
  provider          AuthProvider
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

/// Sesión emitida por GarFit. Sólo se guarda el hash SHA-256 del refresh token (rotativo).
model Session {
  id               String    @id @default(uuid(7))
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Perfil deportivo del atleta (1:1 con User).
model AthleteProfile {
  id              String          @id @default(uuid(7))
  userId          String          @unique
  displayName     String
  experienceLevel ExperienceLevel
  primaryGoal     PrimaryGoal
  preferredUnits  UnitSystem      @default(METRIC)
  /// Datos opcionales útiles para contextualizar el progreso. Sin información médica.
  birthDate       DateTime?       @db.Date
  heightCm        Decimal?        @db.Decimal(4, 1)
  /// Siempre en kg; los clientes convierten según preferredUnits.
  weightKg        Decimal?        @db.Decimal(5, 2)
  trainingSince   DateTime?       @db.Date
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Movimiento del catálogo controlado por el proyecto (semilla desde @garfit/movements).
model Movement {
  id               String              @id @default(uuid(7))
  /// Identificador estable y público; la semilla hace upsert por slug.
  slug             String              @unique
  name             String
  /// Resumen propio. La fuente actual no lo aporta: puede ser nulo.
  description      String?
  instructions     String[]
  category         MovementCategory
  equipment        Equipment
  /// Nulo cuando la fuente no clasifica la dificultad (no se inventa).
  difficulty       MovementDifficulty?
  primaryMuscles   MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  /// Tipos de marca que admite (reglas en @garfit/movements/record-types).
  recordTypes      RecordType[]
  /// Origen del dato para trazabilidad, p. ej. "hasaneyldrm/exercises-dataset" + "0043".
  source           String?
  sourceId         String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  personalRecords PersonalRecord[]

  @@unique([source, sourceId])
  @@index([isActive, name])
  @@index([category])
  @@index([equipment])
}

/// Registro de una marca personal. Cada registro se conserva para calcular la evolución:
/// no se sobrescribe; se corrige con PATCH y se retira con borrado lógico (deletedAt).
model PersonalRecord {
  id              String       @id @default(uuid(7))
  userId          String
  movementId      String
  recordType      RecordType
  /// Valor tal como lo introdujo el atleta, en `unit`.
  value           Decimal      @db.Decimal(12, 3)
  unit            RecordUnit
  /// Valor en unidad canónica (kg, repeticiones, metros o segundos). Se compara con éste.
  normalizedValue Decimal      @db.Decimal(14, 3)
  /// Sólo en marcas de carga: repeticiones de la marca (1 = 1RM).
  repetitions     Int?
  performedAt     DateTime     @db.Date
  notes           String?
  source          RecordSource @default(MANUAL)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, performedAt])
  @@index([userId, movementId, recordType])
}

/// Versión distribuible de la app móvil. El binario vive en ReleaseStorage bajo `filePath`.
model AppRelease {
  id          String          @id @default(uuid(7))
  platform    ReleasePlatform
  /// SemVer, p. ej. 1.0.0.
  version     String
  versionCode Int
  fileName    String
  /// Clave relativa dentro del almacenamiento (nunca una ruta absoluta).
  filePath    String
  fileSize    Int
  sha256      String
  changelog   String[]
  published   Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())

  @@unique([platform, version])
  @@unique([platform, versionCode])
  @@index([platform, published, versionCode])
}
