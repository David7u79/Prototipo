    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "@hpcc-js/wasm-graphviz": "^1.29.1",
    "@types/passport-jwt": "^4",
    "dotenv": "^17",
    "prisma": "7.10.0",
    "prisma-erd-generator": "^3.2.1",
    "yaml": "^2"
