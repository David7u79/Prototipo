# Copia este fichero como .env.local.

# URL base de la API NestJS. Sólo se usa en el servidor de Next.js (server actions,
# proxy.ts y Server Components): los tokens nunca llegan al JavaScript del navegador.
API_URL=http://localhost:4000

# Las cookies de sesión son HttpOnly, SameSite=Lax y host-only. En NODE_ENV=production
# Next.js marca Secure automáticamente; en localhost HTTP permanece desactivada.

# El client ID web de Google NO se configura aquí: la web lo obtiene de GET /auth/providers,
# que lo expone sólo si GOOGLE_WEB_CLIENT_ID está definido en apps/api/.env.
