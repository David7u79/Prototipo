node_modules/
dist/
build/
.next/
.astro/
.expo/
.turbo/
coverage/
!docs/generated/coverage/
*.tsbuildinfo
.DS_Store
npm-debug.log*
pnpm-debug.log*

# Secretos: sólo se versionan los .env.example
.env
.env.*
!.env.example

# Prisma generado
apps/api/src/generated/

# Binarios de releases (se publican vía script, no por git)
storage/releases/android/*
!storage/releases/android/.gitkeep

# Mobile nativo (Development Builds se generan con prebuild)
apps/mobile/android/
apps/mobile/ios/

# Reportes pesados regenerables
docs/generated/typedoc/
docs/generated/coverage/html/
# Capturas de `pnpm evidence:web`: se regeneran en cada ejecución. Las que respaldan un
# resultado académico se copian a docs/evidence/fase-N/ (versionado) junto con su fecha y commit.
docs/evidence/generated/

# Firma de Android: el keystore y sus contraseñas viven fuera del repositorio (ADR 0010 y
# docs/operations/android-signing.md). Nunca se versionan, ni siquiera cifrados.
*.keystore
*.jks
*.keystore.env
keystore.properties
